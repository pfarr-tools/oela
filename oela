#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

ensure_env() {
    if [[ ! -f .env ]]; then
        cp .env.example .env
        echo ".env wurde aus .env.example angelegt."
    fi
}

command="${1:-help}"
shift || true

case "$command" in
    init)
        ensure_env
        exec docker compose run --rm app php oela init "$@"
        ;;
    admin-links)
        ensure_env
        exec docker compose run --rm app php oela admin-links "$@"
        ;;
    up)
        ensure_env
        exec docker compose up "$@"
        ;;
    down)
        exec docker compose down "$@"
        ;;
    restart)
        exec docker compose restart "$@"
        ;;
    status|ps)
        exec docker compose ps "$@"
        ;;
    logs)
        exec docker compose logs -f "$@"
        ;;
    shell)
        exec docker compose exec app sh "$@"
        ;;
    composer)
        ensure_env
        exec docker compose run --rm app composer "$@"
        ;;
    test)
        ensure_env
        exec docker compose run --rm --no-deps \
            -e APP_ENV=testing \
            -e APP_SECRET=oela-testing-secret-oela-testing-secret \
            -e DB_PATH=/tmp/oela-testing.sqlite \
            app sh -c 'php tests/AppTest.php && php tests/ValidationTest.php' "$@"
        ;;
    help|-h|--help)
        cat <<'USAGE'
OELA Entwicklungsbefehle

  ./oela init
  ./oela admin-links
  ./oela up [-d]
  ./oela down
  ./oela restart
  ./oela status
  ./oela logs [dienst]
  ./oela shell
  ./oela composer <befehl>
  ./oela test
USAGE
        ;;
    *)
        echo "Unbekannter Befehl: $command" >&2
        exit 2
        ;;
esac
