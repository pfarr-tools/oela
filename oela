#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

export OELA_UID="${OELA_UID:-$(id -u)}"
export OELA_GID="${OELA_GID:-$(id -g)}"

ensure_env() {
    if [[ ! -f .env ]]; then
        cp .env.example .env
        echo ".env wurde aus .env.example angelegt."
    fi
}

fix_runtime_permissions() {
    docker compose run --rm --user root \
        -e OELA_UID="$OELA_UID" \
        -e OELA_GID="$OELA_GID" \
        app sh -c 'chown "$OELA_UID:$OELA_GID" /var/www/html/var && find /var/www/html/var -maxdepth 1 -type f \( -name "advent.sqlite" -o -name "advent.sqlite-*" \) -exec chown "$OELA_UID:$OELA_GID" {} +'
}

command="${1:-help}"
shift || true

case "$command" in
    init)
        ensure_env
        exec docker compose run --rm app php oela init "$@"
        ;;
    admin-links)
        ensure_env
        exec docker compose run --rm app php oela admin-links "$@"
        ;;
    up)
        ensure_env
        exec docker compose up "$@"
        ;;
    down)
        exec docker compose down "$@"
        ;;
    restart)
        exec docker compose restart "$@"
        ;;
    update)
        ensure_env
        if [[ "${1:-}" != "--after-pull" ]]; then
            git pull --ff-only
            exec "$0" update --after-pull "$@"
        fi
        shift
        docker compose build
        echo "Setze Rechte für die persistenten Laufzeitdaten."
        fix_runtime_permissions
        docker compose run --rm app composer install --no-interaction --prefer-dist --no-progress
        docker compose up -d
        exec docker compose run --rm app php oela init "$@"
        ;;
    status|ps)
        exec docker compose ps "$@"
        ;;
    logs)
        exec docker compose logs -f "$@"
        ;;
    shell)
        exec docker compose exec app sh "$@"
        ;;
    composer)
        ensure_env
        exec docker compose run --rm app composer "$@"
        ;;
    test)
        ensure_env
        exec docker compose run --rm --no-deps \
            -e APP_ENV=testing \
            -e APP_SECRET=oela-testing-secret-oela-testing-secret \
            -e DB_PATH=/tmp/oela-testing.sqlite \
            app sh -c 'php tests/AppTest.php && php tests/ValidationTest.php && php tests/LegalTest.php && php tests/FormTest.php && php tests/CityTemplateTest.php' "$@"
        ;;
    help|-h|--help)
        cat <<'USAGE'
OELA Entwicklungsbefehle

  ./oela init
  ./oela admin-links
  ./oela up [-d]
  ./oela down
  ./oela restart
  ./oela update
  ./oela status
  ./oela logs [dienst]
  ./oela shell
  ./oela composer <befehl>
  ./oela test
USAGE
        ;;
    *)
        echo "Unbekannter Befehl: $command" >&2
        exit 2
        ;;
esac
